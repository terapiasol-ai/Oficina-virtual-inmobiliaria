<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AURION | Oficina Virtual Profesional 24/7</title>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root { --bg-dark:#070A0F; --card-bg:#101722; --gold:#D4AF37; --gold-light:#F7E7B4; --text-light:#E2E8F0; --text-muted:#94A3B8; --accent-green:#25D366; --danger:#EF4444; --blue:#38BDF8; }
        * { box-sizing:border-box; margin:0; padding:0; font-family:'Poppins',sans-serif; }
        body { background-color:var(--bg-dark); color:var(--text-light); line-height:1.6; min-height:100vh; overflow-x:hidden; }
        h1, h2, h3, h4, h5 { font-family:'Cinzel',serif; letter-spacing:0.5px; }
        header { background:linear-gradient(180deg,#141E2C 0%,var(--bg-dark) 100%); border-bottom:2px solid var(--gold); padding:24px 16px 18px; text-align:center; }
        .header-logo-container { margin-bottom:10px; display:flex; justify-content:center; align-items:center; }
        .header-logo { width:92px; height:92px; border-radius:50%; border:2.5px solid var(--gold); object-fit:cover; box-shadow:0 0 22px rgba(212,175,55,0.45); }
        .badge-gold { background:linear-gradient(135deg,var(--gold),#AA7C11); color:#0A0E14; padding:5px 16px; border-radius:20px; font-weight:700; display:inline-block; font-size:0.78rem; text-transform:uppercase; margin-bottom:6px; }
        header h1 { font-size:1.85rem; color:var(--gold-light); margin-bottom:4px; }
        header p { font-size:0.9rem; max-width:800px; margin:0 auto 8px; color:var(--text-muted); }
        .status-bar { font-size:0.84rem; font-weight:600; color:var(--gold-light); }
        .container { max-width:1040px; margin:0 auto; padding:18px 14px 45px; }
        .nav-switch-box { display:flex; justify-content:center; gap:8px; margin-bottom:20px; flex-wrap:wrap; }
        .btn-nav-main { background:#111823; border:1.5px solid var(--gold); color:var(--gold-light); padding:9px 15px; border-radius:25px; font-weight:700; font-size:0.84rem; cursor:pointer; transition:all 0.25s; display:inline-flex; align-items:center; gap:5px; }
        .btn-nav-main.active { background:linear-gradient(135deg,var(--gold),#AA7C11); color:#070A0F !important; box-shadow:0 4px 18px rgba(212,175,55,0.45); transform:translateY(-1px); }
        .seccion-box { display:none; }
        .seccion-box.activa { display:block; animation:fadeIn 0.3s ease; }
        @keyframes fadeIn { from{opacity:0;transform:translateY(6px);} to{opacity:1;transform:translateY(0);} }
        .oficina-box { background:#0E1520; border:2px solid var(--gold); border-radius:16px; padding:18px 15px; box-shadow:0 10px 35px rgba(0,0,0,0.7); }
        .selector-salas { display:grid; grid-template-columns:repeat(auto-fit,minmax(125px,1fr)); gap:8px; margin-bottom:14px; }
        .btn-sala { background:#141D2B; border:1px solid rgba(212,175,55,0.3); border-radius:10px; padding:10px 6px; color:var(--text-light); cursor:pointer; font-size:0.8rem; font-weight:600; display:flex; flex-direction:column; align-items:center; gap:4px; transition:all 0.2s; text-decoration:none; }
        .btn-sala.active { background:linear-gradient(135deg,var(--gold),#AA7C11); color:#070A0F !important; box-shadow:0 0 14px rgba(212,175,55,0.4); }
        .pantalla-chat { background:#090E16; border-radius:12px; min-height:410px; display:flex; flex-direction:column; overflow:hidden; border:1px solid rgba(255,255,255,0.06); }
        .chat-area { flex:1; padding:16px 14px; overflow-y:auto; display:flex; flex-direction:column; gap:12px; min-height:290px; max-height:420px; font-size:0.92rem; }
        .msg-sec { background:#141E2C; border:1px solid rgba(212,175,55,0.3); padding:12px 14px; border-radius:14px 14px 14px 2px; max-width:90%; align-self:flex-start; line-height:1.5; }
        .msg-cli { background:linear-gradient(135deg,var(--gold),#AA7C11); color:#070A0F; padding:10px 14px; border-radius:14px 14px 2px 14px; max-width:85%; font-weight:600; align-self:flex-end; }
        .ia-tag { display:inline-block; font-size:0.68rem; color:var(--gold-light); background:rgba(212,175,55,0.14); border:1px solid rgba(212,175,55,0.35); border-radius:10px; padding:1px 8px; margin-bottom:4px; }
        .input-bar { padding:10px; background:#0E1520; border-top:1px solid rgba(212,175,55,0.2); display:flex; gap:8px; align-items:center; }
        .input-bar input { flex:1; background:#141D2B; border:1px solid rgba(212,175,55,0.3); border-radius:22px; padding:10px 14px; color:#FFF; outline:none; font-size:0.9rem; }
        .btn-mic { background:var(--gold); border:none; color:#000; border-radius:22px; padding:9px 14px; font-weight:700; cursor:pointer; font-size:0.86rem; flex-shrink:0; }
        .btn-mic.recording { background:var(--danger); color:#FFF; }
        .btn-send { background:var(--gold); border:none; color:#000; border-radius:50%; width:40px; height:40px; font-weight:bold; cursor:pointer; flex-shrink:0; font-size:15px; }
        .props-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(270px,1fr)); gap:16px; margin-top:14px; }
        .prop-card { background:#111824; border:1.5px solid var(--gold); border-radius:14px; overflow:hidden; display:flex; flex-direction:column; justify-content:space-between; }
        .prop-imgs { display:flex; overflow-x:auto; gap:4px; background:#06090F; height:190px; }
        .prop-imgs img { height:100%; min-width:100%; object-fit:cover; }
        .prop-body { padding:14px; display:flex; flex-direction:column; gap:6px; flex:1; justify-content:space-between; }
        .prop-badge { display:inline-block; background:rgba(212,175,55,0.2); border:1px solid var(--gold); color:var(--gold-light); font-size:0.72rem; font-weight:700; padding:2px 9px; border-radius:10px; width:fit-content; }
        .form-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:12px; margin-top:14px; }
        .form-group { display:flex; flex-direction:column; gap:4px; text-align:left; }
        .form-group label { font-size:0.82rem; color:var(--gold-light); font-weight:600; }
        .form-group input, .form-group select, .form-group textarea { background:#090E16; border:1px solid rgba(212,175,55,0.35); color:#FFF; padding:9px 11px; border-radius:9px; outline:none; font-size:0.88rem; }
        .calif-box { background:#0B121E; border:1.5px dashed var(--gold); border-radius:12px; padding:14px; margin-top:14px; }
        .priv-check { display:flex; align-items:flex-start; gap:8px; margin-top:12px; background:#09101A; border:1px solid rgba(56,189,248,0.4); padding:10px; border-radius:10px; font-size:0.8rem; color:#CBD5E1; text-align:left; }
        .priv-check input { margin-top:4px; transform:scale(1.2); }
        .btn-submit { background:linear-gradient(135deg,var(--gold),#AA7C11); color:#070A0F; padding:12px 26px; border-radius:30px; font-weight:800; border:none; cursor:pointer; margin-top:14px; font-size:0.96rem; box-shadow:0 4px 18px rgba(212,175,55,0.4); }
        .crm-table-box { overflow-x:auto; margin-top:15px; border-radius:10px; border:1px solid rgba(212,175,55,0.2); }
        .crm-table { width:100%; border-collapse:collapse; font-size:0.84rem; text-align:left; }
        .crm-table th { background:#141D2B; color:var(--gold-light); padding:10px; border-bottom:1.5px solid var(--gold); }
        .crm-table td { padding:9px 10px; border-bottom:1px solid rgba(255,255,255,0.06); vertical-align:top; }
        .hall-banner { background:linear-gradient(135deg,#16202E 0%,#0F1622 100%); border:2px solid var(--gold); border-radius:16px; padding:28px 18px; text-align:center; margin-bottom:20px; }
        .comparativa-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(290px,1fr)); gap:16px; margin:20px 0; }
        .card-gasto { background:rgba(239,68,68,0.06); border:1.5px solid rgba(239,68,68,0.35); border-radius:14px; padding:18px; }
        .card-ahorro { background:rgba(37,211,102,0.06); border:2px solid var(--gold); border-radius:14px; padding:18px; }
        .item-costo { display:flex; justify-content:space-between; padding:7px 0; border-bottom:1px dashed rgba(255,255,255,0.08); font-size:0.86rem; }
        .tools-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:14px; margin:18px 0; }
        .tool-card { background:#111824; border:1.5px solid var(--gold); border-radius:14px; padding:16px; text-align:left; display:flex; flex-direction:column; justify-content:space-between; gap:10px; }
        .btn-descarga { background:rgba(212,175,55,0.15); border:1px solid var(--gold); color:var(--gold-light); padding:8px 14px; border-radius:20px; font-size:0.82rem; font-weight:700; cursor:pointer; }
        .cfg-panel { background:#0B121E; border:1.5px solid var(--blue); border-radius:14px; padding:16px; margin-top:16px; }
        .contador-badge { display:inline-flex; align-items:center; gap:8px; background:#101722; padding:6px 16px; border-radius:20px; border:1.5px solid var(--gold); color:var(--gold-light); font-size:0.82rem; font-weight:700; margin-top:12px; }
        .contador-numero { background:var(--gold); color:#070A0F; padding:2px 8px; border-radius:10px; }
        footer { text-align:center; padding:28px 15px; background:#040608; color:var(--text-muted); margin-top:30px; font-size:0.82rem; border-top:1px solid rgba(212,175,55,0.2); }
    </style>
</head>
<body>
    <header>
        <div class="header-logo-container">
            <img id="brokerLogo" src="https://raw.githubusercontent.com/terapiasol-ai/Aurion/main/Screenshot_20260726_141527_Google.jpg" onerror="this.onerror=null; this.src='https://raw.githubusercontent.com/terapiasol-ai/Aurion/main/image%20(4).jpg';" alt="Oficina Virtual" class="header-logo">
        </div>
        <span class="badge-gold" id="brokerBadge">Corretaje de Propiedades • 24/7</span>
        <h1 id="brokerNombreOficial">Oficina Virtual Profesional 24/7</h1>
        <p id="brokerSubtitulo">Asesoría de Élite, Calificación Automática, Auditoría Legal & Atención sin Descargas</p>
        <div class="status-bar" id="estadoConexion">🟡 Preparando tu Oficina Virtual (unos segundos)...</div>
    </header><div class="container">
        <div class="nav-switch-box">
            <button class="btn-nav-main active" id="btnTabOficina" onclick="mostrarSeccion('oficina')">🏢 Oficina Virtual</button>
            <button class="btn-nav-main" id="btnTabProps" onclick="mostrarSeccion('props')">🏘️ Propiedades</button>
            <button class="btn-nav-main" id="btnTabAgenda" onclick="mostrarSeccion('agenda')">📋 Calificar & Agendar</button>
            <button class="btn-nav-main" id="btnTabCrm" onclick="mostrarSeccion('crm')">🔒 Panel Profesional</button>
            <button class="btn-nav-main" id="btnTabLanding" onclick="mostrarSeccion('landing')">💎 Propuesta & Guías</button>
        </div>

        <div id="seccion-oficina" class="seccion-box activa">
            <div class="oficina-box">
                <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid rgba(212,175,55,0.25); padding-bottom:10px; margin-bottom:12px; flex-wrap:wrap; gap:8px;">
                    <div style="font-size:1.1rem; color:var(--gold-light); font-weight:700;">
                        <span id="salaEmoji">🔑</span> <span id="salaNombre">Soy Comprador</span>
                    </div>
                    <button onclick="toggleAudio()" id="btnAudio" style="background:none; border:none; color:var(--gold); cursor:pointer; font-size:13px; font-weight:700;">🔊 Voz Activa</button>
                </div>

                <div class="selector-salas" id="selectorSalas"></div>

                <div class="pantalla-chat">
                    <div class="chat-area" id="chatArea">
                        <div class="msg-sec" id="msgBienvenida">¡Hola! Soy la <strong>Secretaria Ejecutiva Virtual</strong>. Cuéntame en qué te puedo asesorar hoy o elige una sala arriba.</div>
                    </div>
                    <div class="input-bar">
                        <button class="btn-mic" id="btnMic" onclick="toggleMic()">🎙️ Hablar</button>
                        <input type="text" id="inputChat" placeholder="Habla o escribe tu consulta aquí..." onkeypress="if(event.key==='Enter') enviarMensaje()">
                        <button class="btn-send" onclick="enviarMensaje()">➤</button>
                    </div>
                </div>
            </div>
        </div>

        <div id="seccion-props" class="seccion-box">
            <div class="oficina-box">
                <h2 style="color:var(--gold-light); text-align:center; margin-bottom:6px;">🏘️ Galería de Propiedades Disponibles</h2>
                <p style="text-align:center; color:var(--text-muted); font-size:0.86rem;">Revisa las opciones disponibles y califícate en 1 minuto para coordinar tu visita.</p>
                <div id="galeriaProps" class="props-grid"></div>
            </div>
        </div>

        <div id="seccion-agenda" class="seccion-box">
            <div class="oficina-box">
                <h2 style="color:var(--gold-light); text-align:center; margin-bottom:6px;">📋 Calificación Rápida y Agenda 24/7</h2>
                <p style="text-align:center; color:var(--text-muted); font-size:0.86rem;">Evalúa tu perfil de forma confidencial. Si calificas como <strong>🟢 VIP</strong>, podrás enviar tu cédula de identidad por ambos lados de forma privada.</p>
                <form onsubmit="procesarAgenda(event)">
                    <div class="form-grid">
                        <div class="form-group"><label>Nombre Completo *</label><input type="text" id="ag_nombre" required placeholder="Ej: Carolina Rojas"></div>
                        <div class="form-group"><label>RUT / Documento de Identidad *</label><input type="text" id="ag_rut" required placeholder="Ej: 12.345.678-9"></div>
                        <div class="form-group"><label>Tu Teléfono / Contacto *</label><input type="tel" id="ag_telefono" required placeholder="+56 9 1234 5678"></div>
                        <div class="form-group"><label>Correo Electrónico</label><input type="email" id="ag_email" placeholder="cliente@correo.com"></div>
                        <div class="form-group"><label>Propiedad o Servicio de Interés</label><input type="text" id="ag_propiedad" placeholder="Opcional (se llena solo si vienes de Galería)"></div>
                        <div class="form-group"><label>Tipo de Requerimiento *</label>
                            <select id="ag_servicio" onchange="actualizarCamposCalif()">
                                <option value="Arriendo / Postulación">🏠 Quiero Arrendar (Postulación)</option>
                                <option value="Comprar Propiedad">🔑 Quiero Comprar Propiedad</option>
                                <option value="Vender Propiedad (Captación)">💰 Quiero Vender / Tasación</option>
                                <option value="Arrendador (Poner en Arriendo)">🛡️ Poner Propiedad en Arriendo</option>
                                <option value="Auditoría Legal / Contrato">⚖️ Auditoría / Consulta Profesional</option>
                                <option value="Consulta General">💼 Otro Requerimiento / Consulta</option>
                            </select>
                        </div>
                        <div class="form-group"><label>Fecha Preferida</label><input type="date" id="ag_fecha" required></div>
                        <div class="form-group"><label>Horario</label>
                            <select id="ag_hora">
                                <option value="Mañana (10:00 - 13:00)">Mañana (10:00 - 13:00)</option>
                                <option value="Tarde (15:00 - 18:30)">Tarde (15:00 - 18:30)</option>
                                <option value="Sábado (10:00 - 14:00)">Sábado (10:00 - 14:00)</option>
                            </select>
                        </div>
                    </div>

                    <div id="bloque_arriendo" class="calif-box">
                        <strong style="color:var(--gold-light); font-size:0.86rem;">🏠 Filtro de Solvencia (Ley 18.101)</strong>
                        <div class="form-grid">
                            <div class="form-group"><label>Tu Renta Líquida Mensual ($)</label><input type="number" id="ag_renta" placeholder="Ej: 1800000"></div>
                            <div class="form-group"><label>Valor Arriendo que buscas ($)</label><input type="number" id="ag_canon" placeholder="Ej: 550000"></div>
                            <div class="form-group"><label>¿Tienes 12 cotizaciones AFP?</label><select id="ag_afp"><option value="si">Sí, al día</option><option value="no">No / Independiente</option></select></div>
                            <div class="form-group"><label>¿Dicom Platinum al día?</label><select id="ag_dicom"><option value="si">Sí, limpio</option><option value="no">No / Con anotaciones</option></select></div>
                            <div class="form-group"><label>¿Cuentas con Aval?</label><select id="ag_aval"><option value="si">Sí</option><option value="no">No</option></select></div>
                        </div>
                    </div>

                    <div id="bloque_compra" class="calif-box" style="display:none;">
                        <strong style="color:var(--gold-light); font-size:0.86rem;">🔑 Calificación de Comprador</strong>
                        <div class="form-grid">
                            <div class="form-group"><label>Forma de Pago</label><select id="ag_pago"><option value="Contado">Al Contado</option><option value="Credito Pre-aprobado">Crédito Pre-aprobado</option><option value="En evaluacion con pie">Con pie / En evaluación</option><option value="Sin financiamiento">Aún sin financiamiento</option></select></div>
                            <div class="form-group"><label>Presupuesto Estimado</label><input type="text" id="ag_presup_c" placeholder="Ej: 4.500 UF"></div>
                        </div>
                    </div>

                    <div id="bloque_general" class="calif-box" style="display:none;">
                        <strong style="color:var(--gold-light); font-size:0.86rem;">💼 Evaluación de Prioridad</strong>
                        <div class="form-grid">
                            <div class="form-group"><label>Nivel de Urgencia</label><select id="ag_urgencia"><option value="alta">Alta (Inmediata)</option><option value="media">Media (Esta semana)</option><option value="baja">Solo cotizando</option></select></div>
                            <div class="form-group"><label>Presupuesto / Previsión</label><input type="text" id="ag_presup_g" placeholder="Opcional"></div>
                        </div>
                    </div>

                    <div class="form-group" style="margin-top:12px;"><label>Detalles adicionales</label><textarea id="ag_detalles" rows="2" placeholder="Comuna, características o consulta..."></textarea></div>

                    <label class="priv-check">
                        <input type="checkbox" id="ag_privacidad" required>
                        <span><strong>Protección de Datos Personales:</strong> Autorizo el uso estrictamente confidencial de mis datos solo para esta evaluación y coordinación con el profesional titular.</span>
                    </label>

                    <div style="text-align:center;"><button type="submit" class="btn-submit">✅ Calificar y Confirmar Solicitud</button></div>
                    <div id="resultadoCalif" style="margin-top:14px; text-align:center;"></div>
                </form>
            </div>
        </div>

        <div id="seccion-crm" class="seccion-box">
            <div class="oficina-box">
                <h2 style="color:var(--gold-light); text-align:center; margin-bottom:6px;">🔒 Panel Privado del Profesional</h2>
                <p style="text-align:center; color:var(--text-muted); font-size:0.85rem;">Administra tus prospectos VIP, sube propiedades a tu galería y personaliza tu oficina.</p>
                <div id="crm-login" style="max-width:340px; margin:18px auto; text-align:center;">
                    <div class="form-group"><label>Contraseña de tu Oficina</label><input type="password" id="crm_pass" placeholder="Contraseña" style="text-align:center; font-size:1rem;"></div>
                    <button onclick="cargarCRM()" class="btn-submit" style="padding:10px 22px; font-size:0.92rem; margin-top:10px;">🔓 Entrar al Panel</button>
                    <p style="margin-top:12px; font-size:0.78rem; color:#94A3B8;">¿Eres profesional nuevo? <a href="#" onclick="abrirNuevaOficina(); return false;" style="color:#38BDF8;">Crear mi Oficina aquí</a></p>
                </div>

                <div id="crm-view" style="display:none;">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:12px; flex-wrap:wrap; gap:8px;">
                        <span id="crmTotal" style="color:var(--gold-light); font-weight:700;">0 Prospectos</span>
                        <div style="display:flex; gap:6px; flex-wrap:wrap;">
                            <button onclick="togglePanelProps()" class="btn-nav-main" style="padding:7px 12px; font-size:0.8rem;">🏘️ Subir Propiedad</button>
                            <button onclick="toggleConfigOficina()" class="btn-nav-main" style="padding:7px 12px; font-size:0.8rem;">⚙️ Personalizar Oficina</button>
                            <button onclick="exportarCSV()" class="btn-nav-main" style="padding:7px 12px; font-size:0.8rem;">📥 CSV</button>
                        </div>
                    </div>

                    <div id="panelPropsOficina" class="cfg-panel" style="display:none; border-color:var(--gold);">
                        <h3 style="color:var(--gold-light); font-size:1rem; margin-bottom:8px;">🏘️ Publicar Nueva Propiedad en Galería</h3>
                        <div class="form-grid">
                            <div class="form-group"><label>Título *</label><input type="text" id="prop_titulo" placeholder="Ej: Depto 3D 2B Providencia"></div>
                            <div class="form-group"><label>Operación</label><select id="prop_operacion"><option value="Arriendo">Arriendo</option><option value="Venta">Venta</option></select></div>
                            <div class="form-group"><label>Precio Visible *</label><input type="text" id="prop_precio" placeholder="Ej: $650.000 CLP / mes o 4.800 UF"></div>
                            <div class="form-group"><label>Valor Numérico en $ (si es Arriendo)</label><input type="number" id="prop_valor_num" placeholder="Ej: 650000"></div>
                            <div class="form-group"><label>Comuna / Ciudad</label><input type="text" id="prop_comuna" placeholder="Ej: Providencia"></div>
                            <div class="form-group"><label>Fotos desde tu Celular (máx. 4)</label><input type="file" id="prop_fotos_file" accept="image/*" multiple onchange="procesarFotosProp(this)"></div>
                        </div>
                        <div id="previewFotosProp" style="display:flex; gap:6px; flex-wrap:wrap; margin-top:8px;"></div>
                        <div class="form-group" style="margin-top:8px;"><label>O enlaces URL de fotos (opcional, separados por coma)</label><input type="text" id="prop_fotos_urls" placeholder="https://..."></div>
                        <div class="form-group" style="margin-top:8px;"><label>Descripción</label><textarea id="prop_desc" rows="2" placeholder="Metros cuadrados, estacionamiento, gastos comunes..."></textarea></div>
                        <button onclick="guardarPropiedad()" class="btn-submit" style="padding:9px 20px; font-size:0.86rem; margin-top:10px;">💾 Publicar Propiedad</button>
                        <div id="listaPropsAdmin" style="margin-top:12px;"></div>
                    </div>

                    <div id="panelConfigOficina" class="cfg-panel" style="display:none;">
