        function toggleConfigOficina() {
            const p = document.getElementById("panelConfigOficina");
            p.style.display = p.style.display === "none" ? "block" : "none";
        }

        function procesarFotosProp(input) {
            fotosPropComprimidas = [];
            const prev = document.getElementById("previewFotosProp");
            prev.innerHTML = "";
            const files = Array.from(input.files || []).slice(0, 4);
            files.forEach(file => {
                const reader = new FileReader();
                reader.onload = (ev) => {
                    const img = new Image();
                    img.onload = () => {
                        const canvas = document.createElement("canvas");
                        const maxW = 720;
                        const scale = img.width > maxW ? (maxW / img.width) : 1;
                        canvas.width = img.width * scale;
                        canvas.height = img.height * scale;
                        canvas.getContext("2d").drawImage(img, 0, 0, canvas.width, canvas.height);
                        const dataUrl = canvas.toDataURL("image/jpeg", 0.72);
                        fotosPropComprimidas.push(dataUrl);
                        prev.innerHTML += `<img src="${dataUrl}" style="width:64px;height:64px;object-fit:cover;border-radius:6px;border:1px solid #D4AF37;">`;
                    };
                    img.src = ev.target.result;
                };
                reader.readAsDataURL(file);
            });
        }

        async function guardarPropiedad() {
            const urlsExtra = (document.getElementById("prop_fotos_urls").value || "").split(",").map(x => x.trim()).filter(Boolean);
            const todasFotos = fotosPropComprimidas.concat(urlsExtra).slice(0, 4);
            const payload = {
                broker_id: brokerId,
                password: passActualCRM,
                titulo: document.getElementById("prop_titulo").value.trim(),
                operacion: document.getElementById("prop_operacion").value,
                precio: document.getElementById("prop_precio").value.trim(),
                valor_numerico: document.getElementById("prop_valor_num").value.trim(),
                comuna: document.getElementById("prop_comuna").value.trim(),
                descripcion: document.getElementById("prop_desc").value.trim(),
                fotos: todasFotos
            };
            try {
                const res = await fetch(`${BACKEND_URL}/api/propiedades/guardar`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload)
                });
                const d = await res.json();
                if (!res.ok || d.error) { alert(d.error || "Error al guardar"); return; }
                alert("Propiedad publicada en tu Galería.");
                fotosPropComprimidas = [];
                document.getElementById("previewFotosProp").innerHTML = "";
                document.getElementById("prop_titulo").value = "";
                document.getElementById("prop_precio").value = "";
                document.getElementById("prop_valor_num").value = "";
                document.getElementById("prop_comuna").value = "";
                document.getElementById("prop_fotos_urls").value = "";
                document.getElementById("prop_desc").value = "";
                cargarGaleriaProps();
            } catch(e) { alert("Error de conexión al publicar propiedad."); }
        }

        function pintarListaPropsAdmin(props) {
            const c = document.getElementById("listaPropsAdmin");
            if (!c) return;
            c.innerHTML = props.map(p => `<div style="display:flex;justify-content:space-between;align-items:center;background:#070A0F;padding:6px 10px;border-radius:6px;margin-top:4px;font-size:0.8rem;"><span>${sanitizar(p.titulo)} (${sanitizar(p.precio)})</span><button onclick="eliminarPropiedad('${p.id}')" style="background:#7F1D1D;color:#FFF;border:none;padding:3px 8px;border-radius:4px;cursor:pointer;">Eliminar</button></div>`).join("");
        }

        async function eliminarPropiedad(id) {
            try {
                await fetch(`${BACKEND_URL}/api/propiedades/eliminar`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ broker_id: brokerId, password: passActualCRM, prop_id: String(id) })
                });
                cargarGaleriaProps();
            } catch(e) {}
        }

        function abrirNuevaOficina() {
            modoNuevaOficina = true;
            passActualCRM = "";
            document.getElementById("crm-login").style.display = "none";
            document.getElementById("crm-view").style.display = "block";
            document.getElementById("panelConfigOficina").style.display = "block";
            document.getElementById("cfg_id").value = "";
            document.getElementById("cfg_id").placeholder = "ej: dr_perez o estudio_garcia";
            document.getElementById("cfg_nombre_of").value = "";
            document.getElementById("cfg_asesor").value = "";
            document.getElementById("cfg_pass_new").placeholder = "Crea tu contraseña nueva *";
        }

        async function guardarConfigOficina() {
            const payload = {
                nuevo_id: document.getElementById("cfg_id").value.trim().toLowerCase(),
                es_nueva: modoNuevaOficina,
                password_actual: passActualCRM,
                password_nueva: document.getElementById("cfg_pass_new").value.trim(),
                rubro: document.getElementById("cfg_rubro").value,
                nombre_oficial: document.getElementById("cfg_nombre_of").value.trim(),
                asesor_principal: document.getElementById("cfg_asesor").value.trim(),
                telegram_id: document.getElementById("cfg_tg_id").value.trim(),
                voz: document.getElementById("cfg_voz").value,
                foto_perfil: document.getElementById("cfg_foto").value.trim(),
                reglas_extra: document.getElementById("cfg_reglas").value.trim()
            };
            try {
                const res = await fetch(`${BACKEND_URL}/api/oficina/guardar`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload)
                });
                const d = await res.json();
                if (!res.ok || d.error) { alert(d.error || "No se pudo guardar"); return; }
                const base = window.location.origin + window.location.pathname;
                const link = `${base}?broker=${encodeURIComponent(d.id)}`;
                document.getElementById("linkGeneradoBox").innerHTML = `✅ Guardado. Tu enlace propio es: <a href="${link}" style="color:#38BDF8;font-weight:bold;">${link}</a>`;
            } catch(e) { alert("Error al guardar configuración."); }
        }

        function exportarCSV() {
            if (!datosCRM.length) { alert("No hay datos para exportar."); return; }
            const nl = String.fromCharCode(10);
            let csv = "Calificacion,Fecha Registro,Cliente,RUT,Contacto,Servicio,Propiedad,Fecha Cita,Horario,Detalle" + nl;
            datosCRM.forEach(c => {
                csv += `"${c.calificacion || ''}","${c.fecha_registro || ''}","${c.nombre || ''}","${c.rut || ''}","${c.telefono || ''}","${c.tipo_servicio || ''}","${c.propiedad_interes || ''}","${c.fecha_preferida || ''}","${c.hora_preferida || ''}","${(c.detalle_calif || '') + ' ' + (c.detalles || '').replace(/"/g, "'")}"` + nl;
            });
            const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
            const link = document.createElement("a");
            link.href = URL.createObjectURL(blob);
            link.download = `Agenda_${brokerId}.csv`;
            link.click();
        }

