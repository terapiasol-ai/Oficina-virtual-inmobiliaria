        function cambiarSalaBtn(btn) {
            salaActual = btn.dataset.id;
            document.querySelectorAll(".btn-sala").forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            document.getElementById("salaEmoji").innerText = btn.dataset.ico;
            document.getElementById("salaNombre").innerText = btn.dataset.nom;
            document.getElementById("msgBienvenida").innerHTML = sanitizar(btn.dataset.msg);
            hablarTTS(btn.dataset.msg);
        }

        function toggleAudio() {
            vozActiva = !vozActiva;
            document.getElementById("btnAudio").innerText = vozActiva ? "🔊 Voz Activa" : "🔇 Voz Silenciada";
            if (!vozActiva) {
                try { audioRep.pause(); } catch(e) {}
                if ('speechSynthesis' in window) window.speechSynthesis.cancel();
            }
        }

        function hablarTTS(texto) {
            if (!vozActiva || !('speechSynthesis' in window)) return;
            window.speechSynthesis.cancel();
            const utter = new SpeechSynthesisUtterance((texto || "").replace(/[*#_~`$]/g, " "));
            const voces = window.speechSynthesis.getVoices();
            const vozN = voces.find(v => (v.lang === "es-419" || v.lang === "es-US") && /Natural|Paloma|Google/i.test(v.name)) || voces.find(v => v.lang.startsWith("es") && !v.lang.includes("ES")) || voces.find(v => v.lang.startsWith("es"));
            if (vozN && salaActual !== 'extranjeros') utter.voice = vozN;
            utter.lang = (salaActual === 'extranjeros') ? 'en-US' : 'es-419';
            utter.rate = 0.90;
            window.speechSynthesis.speak(utter);
        }

        function reproducirBase64(b64, fallbackTxt) {
            if (!vozActiva) return;
            if (!b64) { hablarTTS(fallbackTxt); return; }
            try {
                audioRep.pause();
                audioRep.src = "data:audio/mpeg;base64," + b64;
                const p = audioRep.play();
                if (p && typeof p.catch === "function") p.catch(() => hablarTTS(fallbackTxt));
            } catch(e) { hablarTTS(fallbackTxt); }
        }

        const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
        if (SpeechRec) {
            recognition = new SpeechRec();
            recognition.onstart = () => { grabando = true; const b = document.getElementById("btnMic"); b.classList.add("recording"); b.innerText = "🔴 Escuchando..."; };
            recognition.onresult = (e) => {
                if (e.results && e.results[0]) { document.getElementById("inputChat").value = e.results[0][0].transcript; enviarMensaje(); }
            };
            recognition.onerror = (e) => {
                resetMic();
                if (e.error === "not-allowed" || e.error === "service-not-allowed") {
                    document.getElementById("chatArea").innerHTML += `<div class="msg-sec">🎙️ Activa el permiso de micrófono en Chrome para hablar.</div>`;
                }
            };
            recognition.onend = () => resetMic();
        }

        function toggleMic() {
            if (!recognition) { alert("Micrófono no disponible aquí. Ábrelo en Google Chrome."); return; }
            if (grabando) { recognition.stop(); return; }
            try { audioRep.pause(); } catch(e) {}
            document.getElementById("inputChat").value = "";
            recognition.lang = (salaActual === 'extranjeros') ? 'en-US' : 'es-419';
            try { recognition.start(); } catch(e) { resetMic(); }
        }
        function resetMic() { grabando = false; const b = document.getElementById("btnMic"); if (b) { b.classList.remove("recording"); b.innerText = "🎙️ Hablar"; } }

        async function enviarMensaje() {
            const inp = document.getElementById("inputChat");
            const txt = inp.value.trim();
            if (!txt) return;
            const chat = document.getElementById("chatArea");
            chat.innerHTML += `<div class="msg-cli">${sanitizar(txt)}</div>`;
            inp.value = "";
            chat.scrollTop = chat.scrollHeight;

            const load = document.createElement("div");
            load.className = "msg-sec";
            load.innerText = "✨ Analizando tu consulta...";
            chat.appendChild(load);
            chat.scrollTop = chat.scrollHeight;

            try {
                const res = await fetch(`${BACKEND_URL}/api/chat`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ broker_id: brokerId, sala: salaActual, mensaje: txt, sesion_id: sesionId, generar_audio: vozActiva })
                });
                load.remove();
                if (!res.ok) throw new Error("HTTP " + res.status);
                const d = await res.json();
                const textoResp = sanitizar(d.respuesta || "").split(String.fromCharCode(10)).join("<br>");
                const nomVoz = brokerVoz.includes("Alonso") ? "AlonsoNeural" : "PalomaNeural";
                const tag = d.modelo ? `<div class="ia-tag">✨ IA (${sanitizar(d.modelo)}) • 🔊 ${nomVoz}</div><br>` : "";
                chat.innerHTML += `<div class="msg-sec">${tag}${textoResp}</div>`;
                chat.scrollTop = chat.scrollHeight;
                reproducirBase64(d.audio_base64, d.respuesta);
            } catch (e) {
                load.remove();
                chat.innerHTML += `<div class="msg-sec">⚠️ No pude conectar con el servidor (${sanitizar(e.message)}). Si estaba en reposo, espera unos segundos y vuelve a intentar.</div>`;
            }
        }

